{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName": "GafCoreAI",
    "version": "1.5.1",
    "identifier":  "com.gafcore.gafcoreai",
    "build":  {
                  "frontendDist":  "../web",
                  "beforeDevCommand":  "",
