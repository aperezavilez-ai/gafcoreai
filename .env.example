# ============================================================
#  GafCoreAI - Variables de entorno de referencia
#  Copia este archivo como .env.local y completa los valores vacios.
#  .env y .env.local estan en .gitignore: nunca se suben a GitHub.
#
#  La app de escritorio NO lee este archivo en ejecucion: la conexion a
#  Supabase ya viene configurada y las API keys de los modelos se guardan
#  en el almacen seguro de la app. Estas variables son para scripts,
#  migraciones y la firma de releases.
# ============================================================

# --- Supabase GAFCORE self-hosted (nunca *.supabase.co) ---
SUPABASE_URL=https://supabase.gafcore.com
SUPABASE_SCHEMA=gafcoreai
# Clave publica (anon), la misma de AGENTS.md
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InRheGlkcml2Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTA3OTMwMDQsImV4cCI6MjEwNjE1MzAwNH0.tP1IWgKG3pimuIW_oIrCsTf9PKjiOrU1ulVcq-9Btl0
# Secreta: solo en .env.local, nunca en codigo ni en archivos publicos
SUPABASE_SERVICE_ROLE_KEY=

# Conexion directa a Postgres local (para aplicar migraciones de supabase/migrations)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres?schema=gafcoreai

# --- Firma de actualizaciones (boton "Actualizar") ---
# Necesarias solo si se activa createUpdaterArtifacts en tauri.conf.json
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
